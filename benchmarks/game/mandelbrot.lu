// The Computer Language Benchmarks Game — mandelbrot
//   https://benchmarksgame-team.pages.debian.net/benchmarksgame/description/mandelbrot.html
//
// Writes a binary PBM (P4) of the Mandelbrot set, 50 iterations, escape
// radius 2. One bit per pixel, most-significant bit leftmost.
//
//   lu build benchmarks/game/mandelbrot.lu && ./mandelbrot 16000 > out.pbm
//
// The language has no bitwise operators, so bits are packed arithmetically:
// `byte = byte * 2 + bit` shifts left by one, and a short final byte in a row
// is padded by multiplying by the remaining power of two.

fn parse_int(s: str): i64 {
  var acc = 0
  var i = 0
  while i < len(s) {
    let d = s[i] - '0'
    if d >= 0 and d <= 9 { acc = acc * 10 + d }
    i = i + 1
  }
  return acc
}

fn shift_left(v: i64, k: i64): i64 {
  var out = v
  var i = 0
  while i < k {
    out = out * 2
    i = i + 1
  }
  return out
}

// 1 if c stays bounded through 50 iterations, 0 if it escapes
fn in_set(cr: f64, ci: f64): i64 {
  var zr = 0.0
  var zi = 0.0
  var i = 0
  var escaped = false
  while i < 50 and not escaped {
    let zr2 = zr * zr
    let zi2 = zi * zi
    if zr2 + zi2 > 4.0 {
      escaped = true
    } else {
      zi = 2.0 * zr * zi + ci
      zr = zr2 - zi2 + cr
      i = i + 1
    }
  }
  if escaped { return 0 }
  return 1
}

main {
  var w = 200
  if nargs() > 0 { w = parse_int(arg(0)) }
  let h = w

  puts("P4")
  putnl()
  puti(w)
  puts(" ")
  puti(h)
  putnl()

  let fw = float(w)
  let fh = float(h)

  for y in 0..h {
    let ci = 2.0 * float(y) / fh - 1.0
    var byte = 0
    var nbits = 0
    for x in 0..w {
      let cr = 2.0 * float(x) / fw - 1.5
      byte = byte * 2 + in_set(cr, ci)
      nbits = nbits + 1
      if nbits == 8 {
        puts(chr(byte))
        byte = 0
        nbits = 0
      }
    }
    // pad a partial trailing byte with zero bits on the right
    if nbits > 0 {
      puts(chr(shift_left(byte, 8 - nbits)))
    }
  }
}
